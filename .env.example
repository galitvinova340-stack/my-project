# Скопируйте этот файл в .env и заполните реальными значениями.
# .env никогда не должен попадать в git (см. .gitignore).

# --- LLM (извлечение фактов и досье) ---
ANTHROPIC_API_KEY=
# Если модель не найдена/устарела — уточните актуальный slug в доке Anthropic.
ANTHROPIC_MODEL=claude-sonnet-5

# --- Telegram (Telethon, доступ от имени личного аккаунта) ---
# Получить на https://my.telegram.org -> API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Имя файла сессии — при первом запуске scripts/telegram_login.py
# потребуется один раз ввести номер телефона и код подтверждения.
TELEGRAM_SESSION_NAME=state/telegram_session

# --- Почта (уведомления) ---
SMTP_HOST=smtp.mail.ru
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=ga.litvinova@mail.ru

# --- Хранилище ---
EXCEL_DIR=C:\CKB\назначения
EXCEL_FILENAME=Назначения.xlsx
STATE_DIR=state
